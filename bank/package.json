{
  "name": "stands-kit-bank",
  "version": "1.0.0",
  "private": true,
  "description": "ЗапускБанк — учебный банк платформы «Запускай»",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint src web/src",
    "test": "tsx --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "test:unit": "tsx --test \"src/**/!(*.integration).test.ts\" \"web/src/**/*.test.ts\"",
    "test:brokers": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://student:student@127.0.0.1:25432/student} TEST_KAFKA_BROKERS=${TEST_KAFKA_BROKERS:-127.0.0.1:29092} TEST_RABBITMQ_URL=${TEST_RABBITMQ_URL:-amqp://guest:guest@127.0.0.1:25672} tsx --test \"src/**/*.integration.test.ts\"",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://student:student@127.0.0.1:25432/student} tsx --test \"src/**/*.integration.test.ts\"",
    "build:server": "tsc -p tsconfig.build.json",
    "dev:web": "vite --config web/vite.config.ts",
    "infra:up": "docker compose -f compose.test.yaml up -d --wait",
    "infra:down": "docker compose -f compose.test.yaml down -v"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "amqplib": "^2.2.0",
    "express": "^5.3.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7"
  }
}
